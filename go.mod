// Module github.com/ivancarlosti/up contains the complete Up backend: a
// minimalist, cluster ready uptime monitoring server that serves its own
// embedded Vue 3 frontend.
module github.com/ivancarlosti/up

// Go 1.27 is required by github.com/nicholas-fedor/shoutrrr (the notification
// engine used for SMTP and webhook delivery).
go 1.27

require (
	github.com/coreos/go-oidc/v3 v3.21.0
	github.com/gin-gonic/gin v1.12.0
	github.com/google/uuid v1.6.0
